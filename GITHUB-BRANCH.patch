diff --git a/www/portal.html b/www/portal.html
new file mode 100644
index 0000000..1fd4ce3
--- /dev/null
+++ b/www/portal.html
@@ -0,0 +1,275 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+  <meta charset="UTF-8" />
+  <meta
+    name="viewport"
+    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
+  />
+
+  <title>RC ORDERA</title>
+
+  <meta
+    name="description"
+    content="RC ORDERA - Pedidos, restaurantes y entregas en una sola plataforma."
+  />
+
+  <style>
+    * {
+      box-sizing: border-box;
+    }
+
+    html,
+    body {
+      margin: 0;
+      min-height: 100%;
+      font-family:
+        Inter,
+        system-ui,
+        -apple-system,
+        BlinkMacSystemFont,
+        "Segoe UI",
+        sans-serif;
+      background:
+        radial-gradient(circle at top left, #fff4ec 0, transparent 35%),
+        linear-gradient(135deg, #f8fafc 0%, #eef4f0 100%);
+      color: #172033;
+    }
+
+    body {
+      min-height: 100vh;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      padding: 32px 18px;
+    }
+
+    .portal {
+      width: 100%;
+      max-width: 1120px;
+    }
+
+    .brand {
+      text-align: center;
+      margin-bottom: 36px;
+    }
+
+    .brand-mark {
+      width: 74px;
+      height: 74px;
+      margin: 0 auto 16px;
+      border-radius: 22px;
+      display: grid;
+      place-items: center;
+      background: #ff4b19;
+      color: white;
+      font-size: 31px;
+      font-weight: 900;
+      box-shadow: 0 14px 35px rgba(255, 75, 25, 0.25);
+    }
+
+    .brand h1 {
+      margin: 0;
+      font-size: clamp(36px, 7vw, 60px);
+      letter-spacing: -2px;
+      font-weight: 900;
+    }
+
+    .brand p {
+      margin: 10px auto 0;
+      max-width: 650px;
+      color: #667085;
+      font-size: 17px;
+      line-height: 1.55;
+    }
+
+    .apps {
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 20px;
+    }
+
+    .app-card {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      min-height: 330px;
+      padding: 28px;
+      border-radius: 26px;
+      background: rgba(255, 255, 255, 0.94);
+      border: 1px solid #e5e7eb;
+      box-shadow: 0 16px 45px rgba(17, 24, 39, 0.08);
+      text-decoration: none;
+      color: inherit;
+      transition:
+        transform 0.18s ease,
+        box-shadow 0.18s ease;
+    }
+
+    .app-card:hover {
+      transform: translateY(-4px);
+      box-shadow: 0 22px 55px rgba(17, 24, 39, 0.12);
+    }
+
+    .app-card.client {
+      border: 2px solid #ff4b19;
+    }
+
+    .recommended {
+      position: absolute;
+      top: 18px;
+      right: 18px;
+      padding: 7px 10px;
+      border-radius: 999px;
+      background: #fff0ea;
+      color: #e23d10;
+      font-size: 12px;
+      font-weight: 800;
+      text-transform: uppercase;
+      letter-spacing: 0.04em;
+    }
+
+    .icon {
+      width: 60px;
+      height: 60px;
+      display: grid;
+      place-items: center;
+      border-radius: 18px;
+      background: #f3f4f6;
+      font-size: 29px;
+      margin-bottom: 24px;
+    }
+
+    .client .icon {
+      background: #fff0ea;
+    }
+
+    .app-card h2 {
+      margin: 0;
+      font-size: 25px;
+      font-weight: 850;
+    }
+
+    .app-card p {
+      margin: 12px 0 24px;
+      color: #667085;
+      line-height: 1.6;
+      flex: 1;
+    }
+
+    .button {
+      width: 100%;
+      min-height: 52px;
+      border-radius: 15px;
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      font-weight: 800;
+      background: #172033;
+      color: white;
+    }
+
+    .client .button {
+      background: #ff4b19;
+    }
+
+    .footer {
+      margin-top: 28px;
+      text-align: center;
+      color: #98a2b3;
+      font-size: 13px;
+    }
+
+    @media (max-width: 820px) {
+      .apps {
+        grid-template-columns: 1fr;
+      }
+
+      .app-card {
+        min-height: 250px;
+      }
+
+      body {
+        align-items: flex-start;
+      }
+    }
+  </style>
+</head>
+
+<body>
+  <main class="portal">
+
+    <header class="brand">
+      <div class="brand-mark">RC</div>
+
+      <h1>RC ORDERA</h1>
+
+      <p>
+        Elige cómo quieres utilizar RC ORDERA.
+        Pide comida, administra tu restaurante o realiza entregas.
+      </p>
+    </header>
+
+    <section class="apps">
+
+      <!-- CLIENTE -->
+      <a class="app-card client" href="cliente.html">
+        <span class="recommended">Recomendado</span>
+
+        <div class="icon">🛍️</div>
+
+        <h2>Soy cliente</h2>
+
+        <p>
+          Encuentra restaurantes, consulta el menú,
+          realiza tu pedido y sigue su estado.
+        </p>
+
+        <div class="button">
+          Pedir comida
+        </div>
+      </a>
+
+      <!-- RESTAURANTE -->
+      <a class="app-card" href="restaurante.html">
+
+        <div class="icon">🍽️</div>
+
+        <h2>Soy restaurante</h2>
+
+        <p>
+          Gestiona pedidos, menú, cocina,
+          estaciones, personal y operación.
+        </p>
+
+        <div class="button">
+          Administrar restaurante
+        </div>
+      </a>
+
+      <!-- COLABORADOR -->
+      <a class="app-card" href="colaborador.html">
+
+        <div class="icon">🛵</div>
+
+        <h2>Soy colaborador</h2>
+
+        <p>
+          Consulta entregas disponibles,
+          administra tu disponibilidad y realiza domicilios.
+        </p>
+
+        <div class="button">
+          Realizar entregas
+        </div>
+      </a>
+
+    </section>
+
+    <footer class="footer">
+      RC ORDERA · Plataforma de pedidos y entregas
+    </footer>
+
+  </main>
+</body>
+</html>
