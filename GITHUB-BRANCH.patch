@@ -0,0 +1,354 @@
+-- ============================================================
+-- RC ORDERA V5-20261010-02 — Pedidos: bloqueo por id (sin errores en reintentos simultáneos) + IVA por línea.
+-- Derivada de V91-29A. NO EJECUTADA: probar primero en staging (ver scripts/concurrency-test.mjs).
+-- ============================================================
+-- RC ORDERA V5-20261010-02
+-- Cierra la arquitectura del gateway de pedidos sin causar downtime.
+-- Paso A: crea un RPC interno SOLO para service_role.
+-- NO revoca todavía el RPC legacy; eso se hace en V91-29B después de desplegar Edge.
+
+begin;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '30s';
+-- Reject an unreviewed deployed variant rather than overwrite it silently.
+do $v5_preflight$
+declare actual text;
+begin
+ select md5(btrim(regexp_replace(prosrc, '\s+', ' ', 'g'))) into actual
+ from pg_proc where oid=to_regprocedure('public.rc_ordera_create_customer_order_edge(uuid,uuid,text,text,text,text,jsonb,uuid,numeric)');
+ if actual is distinct from '4753a0ba2396730e21197ef14d71a632' then
+  raise exception 'V5_RPC_BASE_MISMATCH: inspect applied RPC and migration ledger before installation';
+ end if;
+end;
+$v5_preflight$;
+
+
+do $$
+begin
+  if to_regprocedure('public.create_customer_order(uuid,uuid,text,text,text,text,jsonb,numeric)') is null then
+    raise exception 'V5-20261010-02: falta create_customer_order legacy. Aplica primero V91-12B.';
+  end if;
+  if to_regprocedure('public.rc_ordera_customer_token_matches(uuid,text)') is null then
+    raise exception 'V5-20261010-02: falta rc_ordera_customer_token_matches.';
+  end if;
+  if to_regclass('public.customer_orders') is null
+     or to_regclass('public.customer_order_access_secrets') is null
+     or to_regclass('public.delivery_quotes') is null then
+    raise exception 'V5-20261010-02: faltan tablas requeridas para pedidos de cliente.';
+  end if;
