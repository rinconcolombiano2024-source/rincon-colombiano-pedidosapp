+create or replace function public.rc_ordera_create_customer_order_edge(
+  p_id uuid,
+  p_user_id uuid,
+  p_public_token text,
+  p_table_label text,
+  p_customer_name text,
+  p_order_type text,
+  p_order_json jsonb,
+  p_customer_user_id uuid,
+  p_total numeric
+)
