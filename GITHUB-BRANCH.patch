+  <script>
+    "use strict";
+
+    const providers = Object.freeze([
+      ["Uber Eats", "uber_eats"],
+      ["Wolt", "wolt"],
+      ["Glovo", "glovo"],
+      ["Bolt Food", "bolt_food"],
+      ["Pyszne.pl", "pyszne"]
+    ]);
+
+    const providerList =
+      document.getElementById("provider-list");
+
+    for (const [name] of providers) {
+      const card = document.createElement("article");
+      card.className = "item";
+
+      const symbol = document.createElement("div");
+      symbol.className = "symbol";
+      symbol.textContent = "🛵";
+
+      const header = document.createElement("div");
+      header.className = "item-head";
+
+      const title = document.createElement("h3");
+      title.textContent = name;
+
+      const status = document.createElement("span");
+      status.className = "status neutral";
+      status.textContent = "Sin conectar";
+
+      header.append(title, status);
+
+      const description = document.createElement("p");
+      description.textContent =
+        "Conexión oficial, pedidos, estados y " +
+        "conciliación pendientes de verificar.";
+
+      const actions = document.createElement("div");
+      actions.className = "actions";
+
+      for (const label of [
+        "Configurar",
+        "Sincronizar pedidos"
+      ]) {
+        const button = document.createElement("button");
+        button.type = "button";
+        button.className =
+          label === "Configurar"
+            ? "action"
+            : "action secondary";
+        button.textContent = label;
+        button.disabled = true;
+        actions.append(button);
+      }
+
+      card.append(
+        symbol,
+        header,
+        description,
+        actions
+      );
+
+      providerList.append(card);
+    }
+
+    const tabs = [
+      ...document.querySelectorAll("[data-tab]")
+    ];
+
+    function activateTab(name, focus = false) {
+      for (const tab of tabs) {
+        const selected = tab.dataset.tab === name;
+        tab.setAttribute(
+          "aria-selected",
+          String(selected)
+        );
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected && focus) tab.focus();
+      }
+
+      for (const namePart of [
+        "fiscal", "delivery", "payment"
+      ]) {
+        document.getElementById(
+          `panel-${namePart}`
+        ).hidden = namePart !== name;
+      }
+    }
+
+    tabs.forEach((tab, index) => {
+      tab.addEventListener("click", () => {
+        activateTab(tab.dataset.tab);
+      });
+
+      tab.addEventListener("keydown", event => {
+        let nextIndex = index;
+
+        if (event.key === "ArrowRight") {
+          nextIndex = (index + 1) % tabs.length;
+        } else if (event.key === "ArrowLeft") {
+          nextIndex =
+            (index + tabs.length - 1) % tabs.length;
+        } else if (event.key === "Home") {
+          nextIndex = 0;
+        } else if (event.key === "End") {
+          nextIndex = tabs.length - 1;
+        } else {
+          return;
+        }
+
+        event.preventDefault();
+        activateTab(
+          tabs[nextIndex].dataset.tab,
+          true
+        );
+      });
+    });
+  </script>
