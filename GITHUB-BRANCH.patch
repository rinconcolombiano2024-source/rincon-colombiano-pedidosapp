+            <button class="action secondary" disabled>
+              Probar conexión
+            </button>
+            <button class="action secondary" disabled>
+              Consultar estado
+            </button>
+          </div>
+        </article>
+
+        <article class="item">
+          <div class="symbol">📋</div>
