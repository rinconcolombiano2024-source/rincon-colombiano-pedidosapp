+      <button class="tab"
+              id="tab-delivery"
+              type="button"
+              role="tab"
+              aria-controls="panel-delivery"
+              aria-selected="false"
+              tabindex="-1"
+              data-tab="delivery">
+        🛵 Reparto
+      </button>
+      <button class="tab"
+              id="tab-payment"
+              type="button"
+              role="tab"
+              aria-controls="panel-payment"
+              aria-selected="false"
+              tabindex="-1"
+              data-tab="payment">
+        💳 Pagos
+      </button>
