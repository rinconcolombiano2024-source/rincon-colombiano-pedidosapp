@@ -0,0 +1,47 @@
+/** Wolt — PROVISIONAL: contrastar con https://developer.wolt.com antes de producción. */
+import { DeliveryAdapterError } from "../adapter-registry.mjs";
+import { buildEvent, cleanCurrency, parseJson, pick, requestDescriptor, toGrosz, verifyWith } from "../canonical.mjs";
+
+export const WOLT_META = Object.freeze({ provider: "wolt", provisional: true, docs: "https://developer.wolt.com" });
+
+export function createWoltAdapter(options = {}) {
+  const { webhookSecret, apiKey, baseUrl = "https://pos-integration-service.wolt.com" } = options;
+  const scheme = options.verification ?? { type: "hmac-sha256", header: "x-wolt-signature", encoding: "hex" };
+  return {
+    meta: WOLT_META,
+    verify: (req) => verifyWith(scheme, req, webhookSecret),
+    normalize(rawBody) {
+      const p = parseJson(rawBody);
+      const o = p.order ?? p;
+      cleanCurrency(pick(o, "price.currency") ?? o.currency);
+      const status = String(pick(o, "status") ?? "CREATED").toUpperCase();
+      const eventType = status === "CANCELLED" || status === "REJECTED" ? "order_cancelled"
+        : status === "CREATED" ? "order_created" : "order_status";
+      return buildEvent("wolt", {
+        orderId: o.id ?? p.order_id,
+        eventId: p.id ?? `${o.id}:${status}:${o.modified_at ?? ""}`,
+        eventType, status,
+        totalGrosz: toGrosz(pick(o, "price.amount") ?? o.total, { unit: "minor" }),
+        fulfillment: pick(o, "delivery.type") === "pickup" ? "pickup" : "delivery",
+        placedAt: o.created_at ?? null,
+        customer: o.consumer ? { name: o.consumer.name, phone: o.consumer.phone_number } : null,
+        notes: o.consumer_comment ?? null,
+        items: (o.items ?? []).map((i) => ({
+          externalId: i.id, name: i.name, quantity: i.count ?? i.quantity,
+          unitPriceGrosz: toGrosz(i.base_price ?? i.price ?? 0),
+          options: (i.options ?? []).map((x) => ({ externalId: x.id, name: x.name, unitPriceGrosz: toGrosz(x.price ?? 0) })),
+        })),
+      });
+    },
+    buildOutbound(action, order) {
+      if (!apiKey) throw new DeliveryAdapterError("NOT_CONFIGURED", "Missing Wolt API key");
+      const map = { accept: "accept", reject: "reject", ready: "ready", delivered: "delivered" };
+      if (!map[action]) throw new DeliveryAdapterError("UNSUPPORTED_ACTION", "Unsupported action");
+      return requestDescriptor({
+        method: "PUT", baseUrl, path: `/orders/${encodeURIComponent(order.orderId)}/${map[action]}`,
+        headers: { "wolt-api-key": apiKey },
+        body: action === "reject" ? { reason: order.reason ?? "unable_to_fulfill" } : {},
+      });
+    },
+  };
+}
diff --git a/delivery-bridge/src/canonical.mjs b/delivery-bridge/src/canonical.mjs
new file mode 100644
index 0000000..5aeba1e
--- /dev/null
+++ b/delivery-bridge/src/canonical.mjs
@@ -0,0 +1,129 @@
+/**
+ * Formato canónico de eventos de reparto + utilidades comunes.
+ * Dinero SIEMPRE en grosze (enteros). Nunca floats.
+ */
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { DeliveryAdapterError } from "./adapter-registry.mjs";
+
+export const EVENT_TYPES = Object.freeze(["order_created", "order_updated", "order_cancelled", "order_status"]);
+export const FULFILLMENT = Object.freeze(["delivery", "pickup"]);
+
+export function toGrosz(value, { unit = "minor" } = {}) {
+  // unit "minor": ya viene en grosze/centavos (entero). unit "major": viene en zł (decimal).
+  if (typeof value === "string" && /^\d+(\.\d{1,2})?$/.test(value.trim())) value = Number(value);
+  if (typeof value !== "number" || !Number.isFinite(value) || value < 0) {
+    throw new DeliveryAdapterError("INVALID_MONEY", "Invalid monetary amount");
+  }
+  if (unit === "major") return Math.round(value * 100);
+  if (!Number.isSafeInteger(value)) throw new DeliveryAdapterError("INVALID_MONEY", "Minor units must be integer");
+  return value;
+}
+
+export function pick(obj, path) {
+  return String(path).split(".").reduce((acc, k) => (acc == null ? undefined : acc[k]), obj);
+}
+
+export function requireString(value, name, max = 160) {
+  if (typeof value !== "string" || !value.trim() || value.length > max || /[\u0000-\u001f\u007f]/.test(value)) {
+    throw new DeliveryAdapterError("INVALID_FIELD", `Invalid field: ${name}`);
+  }
+  return value.trim();
+}
+
+function identifier(value, name) {
+  if (value === undefined || value === null) throw new DeliveryAdapterError("INVALID_FIELD", `Missing ${name}`);
+  return requireString(String(value), name);
+}
+export function buildEvent(provider, f) {
+  if (!EVENT_TYPES.includes(f.eventType)) throw new DeliveryAdapterError("INVALID_EVENT_TYPE", "Unknown event type");
+  const items = (f.items ?? []).map((it) => ({
+    externalId: identifier(it.externalId, "item.externalId"),
+    name: requireString(it.name, "item.name", 200),
+    quantity: Number.isInteger(it.quantity) && it.quantity > 0 && it.quantity <= 999 ? it.quantity
+      : (() => { throw new DeliveryAdapterError("INVALID_FIELD", "Invalid quantity"); })(),
+    unitPriceGrosz: it.unitPriceGrosz,
+    options: (it.options ?? []).map((o) => ({ externalId: String(o.externalId), name: String(o.name).slice(0, 200), unitPriceGrosz: o.unitPriceGrosz ?? 0, quantity: o.quantity ?? 1 })),
+  }));
+  return Object.freeze({
+    provider,
+    orderId: identifier(f.orderId, "orderId"),
+    eventId: identifier(f.eventId, "eventId"),
+    eventType: f.eventType,
+    status: requireString(String(f.status ?? f.eventType), "status", 80),
+    currency: "PLN",
+    totalGrosz: f.totalGrosz ?? null,
+    deliveryFeeGrosz: f.deliveryFeeGrosz ?? 0,
+    fulfillment: FULFILLMENT.includes(f.fulfillment) ? f.fulfillment : "delivery",
+    placedAt: f.placedAt ?? null,
+    customer: f.customer ? { name: String(f.customer.name ?? "").slice(0, 120), phone: String(f.customer.phone ?? "").slice(0, 40) } : null,
+    notes: f.notes ? String(f.notes).slice(0, 500) : null,
+    items,
+    needsFetch: Boolean(f.needsFetch),
+    fetchHref: f.fetchHref ?? null,
+  });
+}
+
+export function cleanCurrency(code, expected = "PLN") {
+  if (code !== undefined && code !== null && String(code).toUpperCase() !== expected) {
+    throw new DeliveryAdapterError("UNSUPPORTED_CURRENCY", "Only PLN orders are supported");
+  }
+}
+
+function toBuf(str, encoding) {
+  return encoding === "base64" ? Buffer.from(str, "base64") : Buffer.from(str, "hex");
+}
+
+/** Verificación genérica: HMAC-SHA256 o token estático, ambos en tiempo constante. */
+export function verifyWith(scheme, { headers, rawBody, now = Date.now() }, secret) {
+  if (!secret || String(secret).length < 16) return false;
+  const h = (n) => headers?.[n.toLowerCase()] ?? headers?.[n] ?? null;
+  if (scheme.type === "static-token") {
+    const got = h(scheme.header);
+    if (typeof got !== "string") return false;
+    const expected = (scheme.prefix ?? "") + secret;
+    const a = Buffer.from(got), b = Buffer.from(expected);
+    return a.length === b.length && timingSafeEqual(a, b);
+  }
+  if (scheme.type === "hmac-sha256") {
+    let sig = h(scheme.header);
+    if (typeof sig !== "string") return false;
+    if (scheme.prefix && sig.startsWith(scheme.prefix)) sig = sig.slice(scheme.prefix.length);
+    let signed = rawBody;
+    if (scheme.timestampHeader) {
+      const ts = h(scheme.timestampHeader);
+      if (!/^\d{10}$/.test(String(ts))) return false;
+      if (Math.abs(Math.floor(now / 1000) - Number(ts)) > (scheme.toleranceSeconds ?? 300)) return false;
+      signed = `${ts}.${rawBody}`;
+    }
+    const expected = createHmac("sha256", secret).update(signed).digest();
+    const encoding = scheme.encoding ?? "hex";
+    if (encoding === "hex" && !/^[0-9a-f]{64}$/i.test(sig)) return false;
+    if (encoding === "base64" && !/^[A-Za-z0-9+/]{43}=$/.test(sig)) return false;
+    let got;
+    try { got = toBuf(sig, scheme.encoding ?? "hex"); } catch { return false; }
+    return got.length === expected.length && timingSafeEqual(got, expected);
+  }
+  return false;
+}
+
+export function parseJson(rawBody, max = 256 * 1024) {
+  if (typeof rawBody !== "string" || rawBody.length === 0 || rawBody.length > max) {
+    throw new DeliveryAdapterError("INVALID_BODY", "Invalid body");
+  }
+  try {
+    const v = JSON.parse(rawBody);
+    if (v === null || typeof v !== "object" || Array.isArray(v)) throw new Error();
+    return v;
+  } catch {
+    throw new DeliveryAdapterError("INVALID_JSON", "Invalid JSON");
+  }
+}
+
+export function requestDescriptor({ method, baseUrl, path, headers = {}, body }) {
+  return Object.freeze({
+    method,
+    url: new URL(path, baseUrl).toString(),
+    headers: Object.freeze({ "content-type": "application/json", ...headers }),
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
diff --git a/delivery-bridge/src/outbox.mjs b/delivery-bridge/src/outbox.mjs
new file mode 100644
index 0000000..329045b
--- /dev/null
+++ b/delivery-bridge/src/outbox.mjs
@@ -0,0 +1,126 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { normalizeProvider } from './providers.mjs';
+const PRECEDENCE = { accept:0, reject:0, ready:1, delivered:2, cancel:9 };
+const TRANSIENT = new Set([408,425,429,500,502,503,504]);
+function fingerprint(value) {
+  if (Array.isArray(value)) return '[' + value.map(fingerprint).join(',') + ']';
+  if (value && typeof value === 'object') return '{' + Object.keys(value).sort().map(k=>JSON.stringify(k)+':'+fingerprint(value[k])).join(',') + '}';
+  return JSON.stringify(value);
+}
+const copy = e => e ? structuredClone(e) : null;
+
+/** Test store only. Production requires a durable atomic backend. */
+export class MemoryOutboxStore {
+  durable = false; #m = new Map(); events = [];
+  async get(id) { return copy(this.#m.get(id)); }
+  async list({limit=100,afterId=null,states=null}={}) {
+    return [...this.#m.values()].filter(e=>(!afterId||e.id>afterId)&&(!states||states.includes(e.state))).sort((a,b)=>a.id.localeCompare(b.id)).slice(0,limit).map(copy);
+  }
+  async due(now,limit=100,blockedProviders=[]) {
+    return [...this.#m.values()].filter(e=>e.state==='pending'&&e.nextAttemptAt<=now&&!blockedProviders.includes(e.provider)
+      &&(e.action!=='ready'||[...this.#m.values()].some(a=>a.restaurantId===e.restaurantId&&a.provider===e.provider&&a.orderId===e.orderId&&a.action==='accept'&&['sent','pending','processing'].includes(a.state))))
+      .sort((a,b)=>PRECEDENCE[a.action]-PRECEDENCE[b.action]||a.createdAt-b.createdAt||a.id.localeCompare(b.id)).slice(0,limit).map(copy);
+  }
+  async insert(e) { if (this.#m.has(e.id)) return false; this.#m.set(e.id,copy(e)); this.events.push({id:e.id,type:'enqueued'}); return true; }
+  async claim(id, token, now, leaseMs) {
+    const e=this.#m.get(id); if (!e || e.state!=='pending' || e.nextAttemptAt>now) return null;
+    if(e.action==='ready'&&![...this.#m.values()].some(a=>a.restaurantId===e.restaurantId&&a.provider===e.provider&&a.orderId===e.orderId&&a.action==='accept'&&a.state==='sent'))return null;
+    const next={...e,state:'processing' ,claimToken:token,leaseUntil:now+leaseMs};
+    this.#m.set(id,next); this.events.push({id,type:'claimed'}); return copy(next);
+  }
+  async finish(e, token) {
+    const old=this.#m.get(e.id); if (old?.state!=='processing' || old.claimToken!==token) throw new Error('CLAIM_LOST');
+    this.#m.set(e.id,copy(e)); this.events.push({id:e.id,type:e.state});
+  }
+  async recover(now) { for (const e of this.#m.values()) if(e.state==='processing' && e.leaseUntil<=now) { e.state='unknown'; e.lastError='worker_lost'; this.events.push({id:e.id,type:'unknown'}); } }
+  async resolve(id,state,evidence) {
+    if (!['sent','dead'].includes(state)||!evidence?.trim()) throw new Error('RECONCILIATION_EVIDENCE_REQUIRED');
+    const e=this.#m.get(id);if(e?.state!=='unknown')throw new Error('NOT_UNKNOWN');
+    e.state=state;e.reconciliationEvidence=evidence;this.events.push({id,type:'reconciled'});
+  }
+}
+function rollback(stats,state){const k={sent:'sent',unknown:'unknown',dead:'dead',pending:'retried'}[state];if(k&&stats[k]>0)stats[k]--;}
+export class DeliveryOutbox {
+  #store; #registry; #options; #fetch; #now; #rand; #cfg; #restaurant; #simulation; #breaker=new Map(); #flight=null;
+  constructor({store=new MemoryOutboxStore(),registry,restaurantId,simulationOnly=false,providerOptions={},fetchImpl=globalThis.fetch,now=()=>Date.now(),random=Math.random,
+    maxAttempts=6,baseDelayMs=2000,maxDelayMs=120000,deadlineMs={accept:240000,reject:240000,ready:1800000,delivered:3600000,cancel:600000},breakerThreshold=5,breakerPauseMs=60000,timeoutMs=10000,leaseMs=30000,batchSize=100,maxTickMs=15000}={}) {
+    if(!registry || typeof registry.create!=='function')throw new Error('REGISTRY_REQUIRED');
+    if(simulationOnly && (typeof fetchImpl!=='function'||fetchImpl===globalThis.fetch))throw new Error('SIMULATION_FETCH_REQUIRED');
+    if(!simulationOnly && (!store.durable || !restaurantId))throw new Error('DURABLE_TENANT_STORE_REQUIRED');
+    if(store.restaurantId && store.restaurantId!==restaurantId)throw new Error('TENANT_MISMATCH');
+    for(const m of ['insert','claim','finish','recover','resolve','list','get','due'])if(typeof store[m]!=='function')throw new Error('ATOMIC_STORE_REQUIRED');
+    if(!Number.isSafeInteger(batchSize)||batchSize<1||batchSize>500||!Number.isFinite(maxTickMs)||maxTickMs<1)throw new Error('INVALID_BATCH');
+    const positiveInteger=v=>Number.isSafeInteger(v)&&v>0;
+    if(![maxAttempts,baseDelayMs,maxDelayMs,breakerThreshold,breakerPauseMs,timeoutMs,leaseMs,maxTickMs].every(positiveInteger)
+      ||maxAttempts>100||maxDelayMs<baseDelayMs||timeoutMs>300000||leaseMs>3600000||maxTickMs>300000
+      ||!deadlineMs||typeof deadlineMs!=='object'||Array.isArray(deadlineMs)
+      ||Object.entries(deadlineMs).some(([action,ms])=>!Object.hasOwn(PRECEDENCE,action)||!positiveInteger(ms)||ms>Number.MAX_SAFE_INTEGER-Date.now()))throw new Error('INVALID_QUEUE_LIMITS');
+    if(leaseMs<=timeoutMs)throw new Error('INVALID_LEASE');
+    this.#store=store;this.#registry=registry;this.#options=providerOptions;this.#fetch=fetchImpl;this.#now=now;this.#rand=random;
+    this.#restaurant=restaurantId??'simulation';this.#simulation=simulationOnly;
+    this.#cfg={maxAttempts,baseDelayMs,maxDelayMs,deadlineMs,breakerThreshold,breakerPauseMs,timeoutMs,leaseMs,batchSize,maxTickMs};
+  }
+  static idFor(provider,orderId,action,restaurantId='simulation') { return createHash('sha256').update(JSON.stringify([restaurantId,normalizeProvider(provider),orderId,action])).digest('hex').slice(0,32); }
+  async enqueue({provider,orderId,action,payload={}}) {
+    if(!Object.hasOwn(PRECEDENCE,action))throw Object.assign(new Error('Unsupported action'),{code:'UNSUPPORTED_ACTION'});
+    provider=normalizeProvider(provider);
+    if(typeof orderId!=='string'||!orderId.trim()||orderId.length>200)throw new Error('INVALID_ORDER');
+    if(!payload||typeof payload!=='object'||Array.isArray(payload)||Object.hasOwn(payload,'orderId'))throw new Error('INVALID_PAYLOAD');
+    if (Buffer.byteLength(JSON.stringify(payload)) > 65536) throw new Error("PAYLOAD_TOO_LARGE");
+    const id=DeliveryOutbox.idFor(provider,orderId,action,this.#restaurant),t=this.#now();
+    const entry={id,restaurantId:this.#restaurant,provider,orderId,action,payload,state:'pending',attempts:0,nextAttemptAt:t,createdAt:t,deadlineAt:t+(this.#cfg.deadlineMs[action]??300000),lastError:null};
+    const inserted=await this.#store.insert(entry),existing=await this.#store.get(id);
+    if(existing && fingerprint(existing.payload)!==fingerprint(payload))throw new Error('IDEMPOTENCY_CONFLICT');
+    return {id,duplicate:!inserted,state:existing?.state??'pending'};
+  }
+  #delay(n) {const exp=Math.min(this.#cfg.maxDelayMs,this.#cfg.baseDelayMs*2**(n-1));return Math.round(exp/2+this.#rand()*exp/2);}
+  tick() {
+    if(this.#flight)return this.#flight;
+    this.#flight=this.#tick().finally(()=>{this.#flight=null;});return this.#flight;
+  }
+  async #tick() {
+    const started=performance.now();const now=this.#now();await this.#store.recover(now,this.#cfg.batchSize);
+    const blocked=[...this.#breaker].filter(([,b])=>b.openUntil>now).map(([p])=>p);
+    const candidates=await this.#store.due(now,this.#cfg.batchSize,blocked);
+    const stats={sent:0,retried:0,dead:0,expired:0,skipped:0,unknown:0,lost:0};
+    for(const candidate of candidates.filter(e=>e.restaurantId===this.#restaurant)) {
+      if(performance.now()-started>=this.#cfg.maxTickMs)break;
+      const claimNow=this.#now();
+      if(candidate.nextAttemptAt>claimNow || (this.#breaker.get(candidate.provider)?.openUntil??0)>claimNow){stats.skipped++;continue;}
+      const token=randomUUID(),e=await this.#store.claim(candidate.id,token,claimNow,this.#cfg.leaseMs);
+      if(!e){stats.skipped++;continue;}
+      if(claimNow>e.deadlineAt){if(await this.#finishSafe({...e,state:'expired',lastError:'deadline_exceeded'},token))stats.expired++;else stats.lost++;continue;}
+      const outcome=await this.#attempt(e); const next={...e,attempts:e.attempts+1,lastError:outcome.reason??null};
+      if(outcome.state==='sent'){next.state='sent';next.sentAt=this.#now();this.#breaker.delete(e.provider);stats.sent++;}
+      else if(outcome.state==='unknown'){next.state='unknown';stats.unknown++;}
+      else if(outcome.state==='dead'){next.state='dead';stats.dead++;}
+      else {
+        const b=this.#breaker.get(e.provider)??{fails:0,openUntil:0};b.fails++;if(b.fails>=this.#cfg.breakerThreshold){b.openUntil=this.#now()+this.#cfg.breakerPauseMs;b.fails=0;}this.#breaker.set(e.provider,b);
+        if(next.attempts>=this.#cfg.maxAttempts){next.state='dead';stats.dead++;}
+        else{next.state='pending';next.nextAttemptAt=this.#now()+this.#delay(next.attempts);stats.retried++;}
+      }
+      if(!(await this.#finishSafe(next,token))){stats.lost++;rollback(stats,next.state);}
+    }
+    return stats;
+  }
+  // CLAIM_LOST: otro proceso ya recuperó/finalizó la operación (lease vencido). No se reintenta ni se aborta el lote.
+  async #finishSafe(entry,token){try{await this.#store.finish(entry,token);return true;}catch(error){if(error?.message==='CLAIM_LOST')return false;throw error;}}
+  async #attempt(e) {
+    let adapter,req;
+    try {
+      adapter=this.#registry.create(e.provider,this.#options[e.provider]??{});
+      if(adapter.meta?.provisional===true&&!this.#simulation)return {state:'dead',reason:'provider_protocol_unverified'};
+      req=adapter.buildOutbound(e.action,{...e.payload,orderId:e.orderId});
+    } catch(error){return {state:'dead',reason:`build_failed:${error?.code??'ERR'}`};}
+    try {
+      const res=await this.#fetch(req.url,{method:req.method,headers:{...req.headers,'idempotency-key':e.id},body:req.body,signal:AbortSignal.timeout(this.#cfg.timeoutMs)});
+      if(res.ok)return {state:'sent'};
+      // HTTP 409 does not prove acceptance of this command.
+      if(res.status===409)return {state:'unknown',reason:'http_409_requires_reconciliation'};
+      if(TRANSIENT.has(res.status))return {state:(adapter.meta?.safeRetries===true||this.#simulation)?'retry':'unknown',reason:`http_${res.status}`};
+      return {state:'dead',reason:`http_${res.status}`};
+    } catch {return {state:'unknown',reason:'network_result_uncertain'};}
+  }
+  async pending({limit=100,afterId=null}={}){return (await this.#store.list({limit,afterId,states:['pending','processing','dead','expired','unknown']})).filter(e=>e.restaurantId===this.#restaurant);}
+  async reconcile(id,state,evidence){const e=await this.#store.get(id);if(e?.restaurantId!==this.#restaurant)throw new Error('TENANT_MISMATCH');await this.#store.resolve(id,state,evidence);}
+}
diff --git a/delivery-bridge/src/postgres-outbox-store.mjs b/delivery-bridge/src/postgres-outbox-store.mjs
new file mode 100644
index 0000000..36cbe3e
--- /dev/null
+++ b/delivery-bridge/src/postgres-outbox-store.mjs
@@ -0,0 +1,88 @@
+/** Inject a parameterized PostgreSQL query(sql, params) function, bound to a trusted backend.
+ * One store is scoped to one restaurant. Never expose a service-role query to browsers.
+ * Atomic UPDATE predicates and claim tokens fence all instances, including crash recovery.
+ */
+export class PostgresOutboxStore {
+  durable = true;
+  constructor({ query, restaurantId }) {
+    if (typeof query !== 'function' || !/^[0-9a-f-]{36}$/i.test(restaurantId ?? '')) throw new Error('INVALID_STORE_CONFIG');
+    this.query = query; this.restaurantId = restaurantId;
+  }
+  async get(id) { return (await this.query('select entry from public.rc_delivery_outbox_v5 where id=$1 and restaurant_user_id=$2', [id, this.restaurantId])).rows[0]?.entry ?? null; }
+  async list({limit=100,afterId=null,states=null}={}) {
+    validatePage(limit,afterId);
+    if(states && (!Array.isArray(states)||states.some(s=>!['pending','processing','sent','dead','expired','unknown'].includes(s))))throw new Error('INVALID_STATES');
+    return (await this.query(`select entry from public.rc_delivery_outbox_v5
+      where restaurant_user_id=$1 and ($2::text is null or id>$2)
+      and ($3::text[] is null or entry->>'state'=any($3)) order by id limit $4`,
+      [this.restaurantId,afterId,states,limit])).rows.map(r=>r.entry);
+  }
+  async due(now,limit=100,blockedProviders=[]) {
+    validatePage(limit);
+    return (await this.query(`select entry from public.rc_delivery_outbox_v5
+      where restaurant_user_id=$1 and entry->>'state'='pending'
+      and (entry->>'nextAttemptAt')::bigint <= $2 and not (entry->>'provider'=any($4::text[]))
+      and (entry->>'action'<>'ready' or exists(select 1 from public.rc_delivery_outbox_v5 accepted
+        where accepted.restaurant_user_id=$1 and accepted.entry->>'provider'=rc_delivery_outbox_v5.entry->>'provider'
+        and accepted.entry->>'orderId'=rc_delivery_outbox_v5.entry->>'orderId'
+        and accepted.entry->>'action'='accept' and accepted.entry->>'state' in ('sent','pending','processing')))
+      order by case entry->>'action' when 'accept' then 0 when 'reject' then 0 when 'ready' then 1 when 'delivered' then 2 else 9 end,
+      (entry->>'createdAt')::bigint,id limit $3`,[this.restaurantId,now,limit,blockedProviders])).rows.map(r=>r.entry);
+  }
+  async insert(entry) {
+    if (entry.restaurantId !== this.restaurantId) throw new Error('TENANT_MISMATCH');
+    const r = await this.query(`with changed as (
+      insert into public.rc_delivery_outbox_v5(id,restaurant_user_id,entry) values($1,$2,$3::jsonb)
+      on conflict(id) do nothing returning id
+    ), journal as (insert into public.rc_delivery_outbox_events_v5(operation_id,restaurant_user_id,event_type)
+      select id,$2,'enqueued' from changed) select id from changed`, [entry.id, this.restaurantId, JSON.stringify(entry)]);
+    return r.rows.length === 1;
+  }
+  async claim(id, token, now, leaseMs) {
+    const r = await this.query(`with changed as (
+      update public.rc_delivery_outbox_v5 set entry=entry || jsonb_build_object('state','processing','claimToken',$3::text,'leaseUntil',$4::bigint + $5::bigint)
+      where id=$1 and restaurant_user_id=$2 and entry->>'state'='pending'
+      and (entry->>'nextAttemptAt')::bigint <= $4::bigint
+      and (entry->>'action'<>'ready' or exists(select 1 from public.rc_delivery_outbox_v5 accepted
+        where accepted.restaurant_user_id=$2 and accepted.entry->>'provider'=rc_delivery_outbox_v5.entry->>'provider'
+        and accepted.entry->>'orderId'=rc_delivery_outbox_v5.entry->>'orderId'
+        and accepted.entry->>'action'='accept' and accepted.entry->>'state'='sent')) returning id, entry
+    ), journal as (insert into public.rc_delivery_outbox_events_v5(operation_id,restaurant_user_id,event_type)
+      select id,$2,'claimed' from changed) select entry from changed`, [id, this.restaurantId, token, now, leaseMs]);
+    return r.rows[0]?.entry ?? null;
+  }
+  async finish(entry, token) {
+    const r = await this.query(`with changed as (
+      update public.rc_delivery_outbox_v5 set entry=$4::jsonb
+      where id=$1 and restaurant_user_id=$2 and entry->>'state'='processing' and entry->>'claimToken'=$3 returning id
+    ), journal as (insert into public.rc_delivery_outbox_events_v5(operation_id,restaurant_user_id,event_type)
+      select id,$2,$5 from changed) select id from changed`, [entry.id, this.restaurantId, token, JSON.stringify(entry), entry.state]);
+    if (r.rows.length !== 1) throw new Error('CLAIM_LOST');
+  }
+  async recover(now,limit=100) {
+    validatePage(limit);
+    await this.query(`with candidates as materialized (
+      select id from public.rc_delivery_outbox_v5
+      where restaurant_user_id=$1 and entry->>'state'='processing' and (entry->>'leaseUntil')::bigint <= $2
+      order by (entry->>'leaseUntil')::bigint,id limit $3 for update skip locked
+    ), changed as (
+      update public.rc_delivery_outbox_v5 set entry=entry || '{"state":"unknown","lastError":"worker_lost"}'::jsonb
+      where id in (select id from candidates)
+      and restaurant_user_id=$1 and entry->>'state'='processing' and (entry->>'leaseUntil')::bigint <= $2 returning id
+    ) insert into public.rc_delivery_outbox_events_v5(operation_id,restaurant_user_id,event_type)
+      select id,$1,'unknown' from changed`, [this.restaurantId, now,limit]);
+  }
+  async resolve(id, state, evidence) {
+    if (!['sent','dead'].includes(state) || typeof evidence !== 'string' || !evidence.trim()) throw new Error('RECONCILIATION_EVIDENCE_REQUIRED');
+    const r = await this.query(`with changed as (
+      update public.rc_delivery_outbox_v5 set entry=entry || jsonb_build_object('state',$3::text,'reconciliationEvidence',$4::text)
+      where id=$1 and restaurant_user_id=$2 and entry->>'state'='unknown' returning id
+    ), journal as (insert into public.rc_delivery_outbox_events_v5(operation_id,restaurant_user_id,event_type)
+      select id,$2,'reconciled' from changed) select id from changed`, [id,this.restaurantId,state,evidence]);
+    if (!r.rows.length) throw new Error('NOT_UNKNOWN');
+  }
+}
+
+function validatePage(limit,afterId=null) {
+ if(!Number.isSafeInteger(limit)||limit<1||limit>500||(afterId!==null&&!/^[0-9a-f]{32}$/.test(afterId)))throw new Error('INVALID_PAGE');
+}
diff --git a/delivery-bridge/src/providers.mjs b/delivery-bridge/src/providers.mjs
new file mode 100644
index 0000000..21de057
--- /dev/null
+++ b/delivery-bridge/src/providers.mjs
@@ -0,0 +1,4 @@
+/** Canonical identifiers match GitHub readiness and SQL contracts. */
+const aliases={ubereats:'uber_eats',boltfood:'bolt_food'};
+const supported=new Set(['uber_eats','wolt','glovo','bolt_food','pyszne']);
+export function normalizeProvider(value){const id=aliases[value]??value;if(!supported.has(id))throw Object.assign(new Error('UNSUPPORTED_PROVIDER'),{code:'UNSUPPORTED_PROVIDER'});return id;}
diff --git a/delivery-bridge/tests/adapters.test.mjs b/delivery-bridge/tests/adapters.test.mjs
new file mode 100644
index 0000000..8d06b7e
--- /dev/null
+++ b/delivery-bridge/tests/adapters.test.mjs
@@ -0,0 +1,122 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import { createPreparedDeliveryRegistry } from "../src/adapter-registry.mjs";
+import { toGrosz, verifyWith } from "../src/canonical.mjs";
+
+// IMPORTANTE: los payloads de este archivo son EJEMPLOS SUPUESTOS (provisional).
+// Sustitúyelos por payloads reales del sandbox de cada plataforma antes de producción.
+
+const SECRET = "s".repeat(40);
+const reg = createPreparedDeliveryRegistry();
+const sign = (body, secret = SECRET) => createHmac("sha256", secret).update(body).digest("hex");
+
+test("toGrosz: enteros, decimales exactos y rechazo de floats/negativos", () => {
+  assert.equal(toGrosz(1999), 1999);
+  assert.equal(toGrosz("19.99", { unit: "major" }), 1999);
+  assert.equal(toGrosz(0.1 + 0.2, { unit: "major" }), 30);
+  assert.throws(() => toGrosz(19.99), { code: "INVALID_MONEY" });
+  assert.throws(() => toGrosz(-1), { code: "INVALID_MONEY" });
+  assert.throws(() => toGrosz(NaN), { code: "INVALID_MONEY" });
+});
+
+test("verifyWith: HMAC válido, alterado, sin secreto corto y con tolerancia de tiempo", () => {
+  const scheme = { type: "hmac-sha256", header: "x-sig", encoding: "hex" };
+  const body = '{"a":1}';
+  assert.equal(verifyWith(scheme, { headers: { "x-sig": sign(body) }, rawBody: body }, SECRET), true);
+  assert.equal(verifyWith(scheme, { headers: { "x-sig": sign(body) }, rawBody: '{"a":2}' }, SECRET), false);
+  assert.equal(verifyWith(scheme, { headers: { "x-sig": sign(body) }, rawBody: body }, "corto"), false);
+  assert.equal(verifyWith(scheme, { headers: { "x-sig": "zz" }, rawBody: body }, SECRET), false);
+  const ts = { ...scheme, timestampHeader: "x-ts", toleranceSeconds: 300 };
+  const now = 1_800_000_000_000, t = String(Math.floor(now / 1000));
+  const good = createHmac("sha256", SECRET).update(`${t}.${body}`).digest("hex");
+  assert.equal(verifyWith(ts, { headers: { "x-sig": good, "x-ts": t }, rawBody: body, now }, SECRET), true);
+  assert.equal(verifyWith(ts, { headers: { "x-sig": good, "x-ts": t }, rawBody: body, now: now + 10 * 60_000 }, SECRET), false);
+});
+
+test("Wolt: verifica, normaliza a grosze y construye acciones salientes", () => {
+  const a = reg.create("wolt", { webhookSecret: SECRET, apiKey: "k".repeat(20) });
+  const body = JSON.stringify({ id: "evt-1", order: { id: "w-100", status: "CREATED", price: { amount: 4590, currency: "PLN" },
+    consumer: { name: "Ana", phone_number: "+48500111222" }, consumer_comment: "sin cebolla",
+    items: [{ id: "i1", name: "Bandeja paisa", count: 2, base_price: 2000, options: [{ id: "o1", name: "Huevo extra", price: 295 }] }] } });
+  assert.equal(a.verify({ headers: { "x-wolt-signature": sign(body) }, rawBody: body }), true);
+  assert.equal(a.verify({ headers: { "x-wolt-signature": sign(body, "x".repeat(40)) }, rawBody: body }), false);
+  const e = a.normalize(body);
+  assert.equal(e.totalGrosz, 4590);
+  assert.equal(e.eventType, "order_created");
+  assert.equal(e.items[0].quantity, 2);
+  assert.equal(e.items[0].options[0].unitPriceGrosz, 295);
+  const req = a.buildOutbound("accept", { orderId: "w-100" });
+  assert.equal(req.method, "PUT");
+  assert.match(req.url, /\/orders\/w-100\/accept$/);
+  assert.throws(() => a.buildOutbound("explode", { orderId: "w-100" }), { code: "UNSUPPORTED_ACTION" });
+});
+
+test("Moneda distinta de PLN se rechaza", () => {
+  const a = reg.create("wolt", { webhookSecret: SECRET });
+  const body = JSON.stringify({ id: "e", order: { id: "w1", status: "CREATED", price: { amount: 100, currency: "EUR" }, items: [] } });
+  assert.throws(() => a.normalize(body), { code: "UNSUPPORTED_CURRENCY" });
+});
+
+test("Glovo: token estático en tiempo constante y normalización", () => {
+  const a = reg.create("glovo", { webhookSecret: SECRET, apiToken: "t".repeat(20), storeId: "st1" });
+  assert.equal(a.verify({ headers: { authorization: SECRET }, rawBody: "{}" }), true);
+  assert.equal(a.verify({ headers: { authorization: SECRET + "x" }, rawBody: "{}" }), false);
+  const body = JSON.stringify({ order_id: "g-7", currency: "PLN", estimated_total_price: 3200, order_time: "2026-10-09T12:00:00Z",
+    customer: { name: "Luis", phone_number: "+48600" }, products: [{ id: "p1", name: "Arepa", quantity: 3, price: 1000 }] });
+  const e = a.normalize(body);
+  assert.equal(e.orderId, "g-7");
+  assert.equal(e.totalGrosz, 3200);
+  assert.equal(a.normalize(body, { cancelled: true }).eventType, "order_cancelled");
+  assert.match(a.buildOutbound("ready", { orderId: "g-7" }).url, /stores\/st1\/orders\/g-7\/ready_for_pickup$/);
+});
+
+test("Uber Eats: notificación pide obtener detalle (needsFetch) y exige https", () => {
+  const a = reg.create("ubereats", { clientSecret: SECRET, accessToken: "a".repeat(20) });
+  const body = JSON.stringify({ event_id: "u-evt", event_type: "orders.notification", meta: { resource_id: "u-9", status: "pos" },
+    resource_href: "https://api.uber.com/v2/eats/order/u-9" });
+  assert.equal(a.verify({ headers: { "x-uber-signature": sign(body) }, rawBody: body }), true);
+  const e = a.normalize(body);
+  assert.equal(e.needsFetch, true);
+  assert.equal(e.fetchHref, "https://api.uber.com/v2/eats/order/u-9");
+  const bad = a.normalize(body.replace("https://", "http://"));
+  assert.equal(bad.fetchHref, null);
+  assert.equal(a.normalize(JSON.stringify({ event_id: "c", event_type: "orders.cancel", meta: { resource_id: "u-9" } })).eventType, "order_cancelled");
+});
+
+test("Pyszne/Bolt: fallan cerrado sin mapping oficial y funcionan con mapping", () => {
+  const closed = reg.create("pyszne", { webhookSecret: SECRET });
+  assert.throws(() => closed.normalize("{}"), { code: "NOT_CONFIGURED" });
+  assert.throws(() => closed.verify({ headers: {}, rawBody: "{}" }), { code: "NOT_CONFIGURED" });
+
+  const a = reg.create("boltfood", {
+    webhookSecret: SECRET,
+    verification: { type: "hmac-sha256", header: "x-bolt-signature", encoding: "hex" },
+    mapping: { currency: "currency", orderId: "order.id", eventId: "event.id", eventType: "event.type",
+      eventTypes: { new: "order_created", cancel: "order_cancelled" }, status: "order.state",
+      total: "order.total", moneyUnit: "major", items: { path: "order.lines", id: "sku", name: "title", quantity: "qty", price: "price" } },
+  });
+  const body = JSON.stringify({ currency: "PLN", event: { id: "b1", type: "new" }, order: { id: "B-5", state: "NEW", total: "25.50",
+    lines: [{ sku: "s1", title: "Empanada", qty: 5, price: "5.10" }] } });
+  assert.equal(a.verify({ headers: { "x-bolt-signature": sign(body) }, rawBody: body }), true);
+  const e = a.normalize(body);
+  assert.equal(e.totalGrosz, 2550);
+  assert.equal(e.items[0].unitPriceGrosz, 510);
+  assert.equal(e.eventType, "order_created");
+});
+
+test("Entradas hostiles: JSON inválido, cuerpo enorme y cantidades absurdas", () => {
+  const a = reg.create("glovo", { webhookSecret: SECRET });
+  assert.throws(() => a.normalize("no-json"), { code: "INVALID_JSON" });
+  assert.throws(() => a.normalize("x".repeat(300_000)), { code: "INVALID_BODY" });
+  const body = JSON.stringify({ order_id: "g", currency: "PLN", estimated_total_price: 1, products: [{ id: "1", name: "x", quantity: 100000, price: 1 }] });
+  assert.throws(() => a.normalize(body), { code: "INVALID_FIELD" });
+});
+
+test('V5: missing order identifiers and malformed signature suffix fail closed',()=>{
+ const a=reg.create('wolt',{webhookSecret:SECRET});
+ assert.throws(()=>a.normalize(JSON.stringify({id:'event',order:{status:'CREATED',price:{amount:100,currency:'PLN'},items:[]}})),{code:'INVALID_FIELD'});
+ const body='{"a":1}';
+ assert.equal(verifyWith({type:'hmac-sha256',header:'x-sig'}, {headers:{'x-sig':sign(body)+'zz'},rawBody:body},SECRET),false);
+ assert.throws(()=>toGrosz(Number.MAX_SAFE_INTEGER+1),{code:'INVALID_MONEY'});
+});
diff --git a/delivery-bridge/tests/outbox-claim-lost.test.mjs b/delivery-bridge/tests/outbox-claim-lost.test.mjs
new file mode 100644
index 0000000..c8f878a
--- /dev/null
+++ b/delivery-bridge/tests/outbox-claim-lost.test.mjs
@@ -0,0 +1,34 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { DeliveryOutbox, MemoryOutboxStore } from "../src/outbox.mjs";
+import { createPreparedDeliveryRegistry } from "../src/adapter-registry.mjs";
+
+const registry = createPreparedDeliveryRegistry();
+const opts = { wolt: { apiKey: "k".repeat(20), webhookSecret: "s".repeat(32) } };
+
+test("CLAIM_LOST en una operación no aborta el lote: las demás se procesan y se cuenta como 'lost'", async () => {
+  const inner = new MemoryOutboxStore();
+  let failOnce = true;
+  const store = new Proxy(inner, { get(t, k) {
+    if (k === "finish") return async (e, token) => { if (failOnce) { failOnce = false; throw new Error("CLAIM_LOST"); } return t.finish(e, token); };
+    const v = t[k]; return typeof v === "function" ? v.bind(t) : v; } });
+  const calls = [];
+  const box = new DeliveryOutbox({ store, registry, simulationOnly: true, providerOptions: opts,
+    fetchImpl: async (url) => { calls.push(url); return { ok: true, status: 200 }; } });
+  for (const id of ["w1", "w2", "w3"]) await box.enqueue({ provider: "wolt", orderId: id, action: "accept" });
+  const stats = await box.tick();
+  assert.equal(stats.lost, 1);
+  assert.equal(stats.sent, 2);          // las otras dos sí se enviaron y registraron
+  assert.equal(calls.length, 3);        // la perdida SÍ se envió una vez (la reclamación era suya al enviar)
+  const again = await box.tick();       // la perdida queda 'processing' hasta que recover() la pase a 'unknown': nunca se reenvía sola
+  assert.equal(calls.length, 3);
+  assert.equal(again.sent, 0);
+});
+
+test("un error de almacén distinto de CLAIM_LOST sí se propaga (no se silencia)", async () => {
+  const inner = new MemoryOutboxStore();
+  const store = new Proxy(inner, { get(t, k) { if (k === "finish") return async () => { throw new Error("DB_DOWN"); }; const v = t[k]; return typeof v === "function" ? v.bind(t) : v; } });
+  const box = new DeliveryOutbox({ store, registry, simulationOnly: true, providerOptions: opts, fetchImpl: async () => ({ ok: true, status: 200 }) });
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  await assert.rejects(() => box.tick(), /DB_DOWN/);
+});
diff --git a/delivery-bridge/tests/outbox.test.mjs b/delivery-bridge/tests/outbox.test.mjs
new file mode 100644
index 0000000..7131f3b
--- /dev/null
+++ b/delivery-bridge/tests/outbox.test.mjs
@@ -0,0 +1,79 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { DeliveryOutbox, MemoryOutboxStore } from "../src/outbox.mjs";
+import { createPreparedDeliveryRegistry } from "../src/adapter-registry.mjs";
+
+const registry = createPreparedDeliveryRegistry();
+const opts = { wolt: { apiKey: "k".repeat(20), webhookSecret: "s".repeat(32) } };
+function harness(responder, extra = {}) {
+  let t = 1_000_000; const calls = [];
+  const fetchImpl = async (url, init) => { calls.push({ url, method: init.method, key: init.headers["idempotency-key"] }); const r = await responder(calls.length, url); if (r instanceof Error) throw r; return { ok: r < 300, status: r }; };
+  const box = new DeliveryOutbox({ registry, simulationOnly: true, providerOptions: opts, fetchImpl, now: () => t, random: () => 0.5, ...extra });
+  return { box, calls, advance: (ms) => { t += ms; }, store: box };
+}
+
+test("encolar es idempotente: mismo (plataforma, pedido, acción) no duplica", async () => {
+  const { box } = harness(async () => 200);
+  const a = await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  const b = await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  assert.equal(a.id, b.id); assert.equal(b.duplicate, true);
+});
+
+test("envío correcto una sola vez, con cabecera de idempotencia", async () => {
+  const { box, calls } = harness(async () => 200);
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  assert.equal((await box.tick()).sent, 1); assert.equal((await box.tick()).sent, 0);
+  assert.equal(calls.length, 1); assert.match(calls[0].url, /orders\/w1\/accept$/); assert.equal(calls[0].key.length, 32);
+});
+
+test("reintenta 5xx seguros en simulación con backoff y acaba enviando", async () => {
+  const { box, calls, advance } = harness(async (n) => (n === 1 ? 503 : n === 2 ? 503 : 200));
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  assert.equal((await box.tick()).retried, 1); assert.equal((await box.tick()).sent, 0);
+  assert.equal(calls.length, 1); assert.equal((await box.pending())[0].state, 'pending'); // aún en espera, excluida por la consulta acotada
+  advance(30_000); assert.equal((await box.tick()).retried, 1);
+  advance(30_000); assert.equal((await box.tick()).sent, 1); assert.equal(calls.length, 3);
+});
+
+test("4xx es definitivo (dead) y no se reintenta; 409 requiere conciliación", async () => {
+  let h = harness(async () => 400);
+  await h.box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  assert.equal((await h.box.tick()).dead, 1); h.advance(500_000); assert.equal((await h.box.tick()).sent, 0); assert.equal(h.calls.length, 1);
+  h = harness(async () => 409);
+  await h.box.enqueue({ provider: "wolt", orderId: "w2", action: "accept" });
+  assert.equal((await h.box.tick()).unknown, 1);
+});
+
+test("'ready' espera a que 'accept' esté enviado; se respeta el orden", async () => {
+  const { box, calls, advance } = harness(async (n) => (n === 1 ? 503 : 200));
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "ready" });
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  await box.tick(); assert.match(calls[0].url, /accept/); assert.equal(calls.length, 1); // accept falló; ready no se envió
+  advance(200_000); await box.tick(); advance(1); await box.tick();
+  assert.deepEqual(calls.map((c) => c.url.split("/").pop()), ["accept", "accept", "ready"]);
+});
+
+test("plazo vencido => expired (no se envía tarde)", async () => {
+  const { box, calls, advance } = harness(async () => 200);
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  advance(10 * 60_000);
+  assert.equal((await box.tick()).expired, 1); assert.equal(calls.length, 0);
+  assert.equal((await box.pending())[0].state, "expired");
+});
+
+test("máximo de intentos => dead; disyuntor pausa la plataforma tras fallos seguidos", async () => {
+  const { box, calls, advance } = harness(async () => 503, { maxAttempts: 3, breakerThreshold: 2, breakerPauseMs: 60_000, deadlineMs: { accept: 1e9, ready: 1e9, delivered: 1e9, cancel: 1e9, reject: 1e9 } });
+  await box.enqueue({ provider: "wolt", orderId: "w1", action: "accept" });
+  await box.enqueue({ provider: "wolt", orderId: "w2", action: "accept" });
+  await box.tick(); // dos intentos fallidos -> el disyuntor se abre
+  advance(10_000); const s = await box.tick(); assert.equal(s.sent, 0); assert.equal(calls.length, 2);
+  assert.ok((await box.pending()).every(e=>e.state==='pending')); // el disyuntor excluye el proveedor antes de cargar filas
+  for (let i = 0; i < 6; i++) { advance(200_000); await box.tick(); }
+  assert.ok((await box.pending()).every((e) => e.state === "dead"));
+});
+
+test("proveedor sin credenciales falla cerrado (dead, sin llamar a la red)", async () => {
+  const { box, calls } = harness(async () => 200);
+  await box.enqueue({ provider: "pyszne", orderId: "p1", action: "accept" });
+  assert.equal((await box.tick()).dead, 1); assert.equal(calls.length, 0);
+});
