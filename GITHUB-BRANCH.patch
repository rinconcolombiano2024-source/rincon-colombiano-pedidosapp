diff --git a/accounting/bin/close.mjs b/accounting/bin/close.mjs
new file mode 100644
index 0000000..7f089fb
--- /dev/null
+++ b/accounting/bin/close.mjs
@@ -0,0 +1,31 @@
+#!/usr/bin/env node
+/**
+ * Uso: node accounting/bin/close.mjs --daily 2026-10-10 --input export.json [--default-vat 8] [--fiscal-required]
+ *      node accounting/bin/close.mjs --monthly 2026-10 --days-dir ./cierres
+ * export.json = { orders, payments, refunds, allocations, fiscalOps } (ver daily-close.mjs).
+ * Escribe cierre-AAAA-MM-DD.json y .csv; sale con código 1 si hay incidencias (cierre NO válido).
+ */
+import { readFileSync, writeFileSync, readdirSync } from "node:fs";
+import { buildDailyClose } from "../src/daily-close.mjs";
+import { buildMonthlyClose } from "../src/monthly-close.mjs";
+import { fromGrosz } from "../src/money.mjs";
+
+const a = process.argv.slice(2);
+const arg = (n) => { const i = a.indexOf(n); return i >= 0 ? a[i + 1] : undefined; };
+if (arg("--daily")) {
+  const date = arg("--daily");
+  const c = buildDailyClose(JSON.parse(readFileSync(arg("--input"), "utf8")), { date, defaultVatRate: arg("--default-vat") ?? null, fiscalRequired: a.includes("--fiscal-required") });
+  writeFileSync(`cierre-${date}.json`, JSON.stringify(c, null, 2));
+  const rows = [["tasa", "bruto", "neto", "iva"], ...Object.entries(c.vat.byRate).map(([r, v]) => [r, fromGrosz(v.gross), fromGrosz(v.net), fromGrosz(v.vat)])];
+  writeFileSync(`cierre-${date}.csv`, rows.map((r) => r.join(";")).join("\n") + "\n");
+  console.log(`Cierre ${date}: ${c.orders} pedidos, bruto ${fromGrosz(c.grossGrosz)} PLN, reembolsos ${fromGrosz(c.refundsGrosz)}, incidencias ${c.issues.length}`);
+  for (const i of c.issues) console.log(`  ! ${i.code} ${i.ref} ${i.detail}`);
+  process.exit(c.issues.length ? 1 : 0);
+} else if (arg("--monthly")) {
+  const dir = arg("--days-dir") || ".";
+  const days = readdirSync(dir).filter((f) => /^cierre-\d{4}-\d{2}-\d{2}\.json$/.test(f)).map((f) => JSON.parse(readFileSync(`${dir}/${f}`, "utf8")));
+  const m = buildMonthlyClose(days, arg("--monthly"));
+  writeFileSync(`cierre-mensual-${m.month}.json`, JSON.stringify(m, null, 2));
+  console.log(`Mes ${m.month}: ${m.days} días, bruto ${fromGrosz(m.grossGrosz)} PLN, faltan ${m.missingDays.length} días, incidencias ${m.issuesCount}, completo=${m.complete}`);
+  process.exit(m.complete ? 0 : 1);
+} else { console.error("Indica --daily AAAA-MM-DD o --monthly AAAA-MM"); process.exit(2); }
diff --git a/accounting/src/adapters.mjs b/accounting/src/adapters.mjs
new file mode 100644
index 0000000..693e008
--- /dev/null
+++ b/accounting/src/adapters.mjs
@@ -0,0 +1,28 @@
+import { toGrosz, fromGrosz, AccountingError } from "./money.mjs";
+
+/** Adapta filas reales de Supabase (customer_orders, payment_transactions, ...) a la entrada canónica del cierre. */
+export function fromCustomerOrderRow(row) {
+  const j = row.order_json ?? {};
+  function quantity(i) {
+    const n = Number(i.quantity ?? i.qty ?? 1);
+    if (!Number.isSafeInteger(n) || n < 1 || n > 999) throw new AccountingError("INVALID_QUANTITY", "Invalid item quantity");
+    return n;
+  }
+  const items = Array.isArray(j.items) ? j.items.map((i) => ({
+    lineTotal: i.total_snapshot ?? fromGrosz(toGrosz(i.unit_price_snapshot ?? i.price ?? 0) * quantity(i)),
+    productId: i.product_id ?? i.productId ?? null,
+    quantity: quantity(i),
+    vatRate: i.vat_rate_snapshot ?? null,
+    vatSnapshotPresent: Object.hasOwn(i, "vat_rate_snapshot"), // explicit null is unresolved, not a legacy default
+  })) : null;
+  return {
+    id: row.id, status: row.status, total: row.total, currency: row.currency,
+    payment_method: row.payment_method, payment_status: row.payment_status, created_at: row.created_at,
+    channel: j.channel ?? "own_app",
+    delivery_vat_rate: j.delivery_vat_rate_snapshot ?? null,
+    deliveryVatSnapshotPresent: Object.hasOwn(j, "delivery_vat_rate_snapshot"),
+    delivery_fee: row.final_delivery_fee ?? 0,
+    ...(items ? { items } : {}),
+  };
+}
+export const fromPaymentRow = (r) => ({ id: r.id, customer_order_id: r.customer_order_id, status: r.status, amount: r.amount, currency: r.currency, provider_reference: r.provider_reference, paid_at: r.paid_at });
diff --git a/accounting/src/daily-close.mjs b/accounting/src/daily-close.mjs
new file mode 100644
index 0000000..49145cc
--- /dev/null
+++ b/accounting/src/daily-close.mjs
@@ -0,0 +1,202 @@
+/**
+ * Cierre diario. Entrada CANÓNICA (adapta tus filas de Supabase a esta forma):
+ *  orders:   { id, status, total, currency, payment_method, payment_status, created_at, channel?, delivery_fee?,
+ *              items?: [{ lineTotal, vatRate? }] }
+ *  payments: { id, customer_order_id, status, amount, currency, provider_reference?, paid_at? }
+ *  refunds:  { id, payment_transaction_id, customer_order_id, status, amount, processed_at? }
+ *  allocations: { payment_transaction_id, customer_order_id, gross_amount, restaurant_net_amount, courier_net_amount,
+ *                 platform_amount, restaurant_fee_amount, courier_fee_amount }
+ *  fiscalOps: { order_id, state }   (opcional)
+ * Venta reconocida: pedido pagado online (payment_status 'paid') o pedido en efectivo/terminal entregado.
+ */
+import { createHash } from "node:crypto";
+import { AccountingError, toGrosz, fromGrosz, sum } from "./money.mjs";
+import { vatSummary, normalizeRate } from "./vat.mjs";
+
+const dateFormatters = new Map();
+function dateFormatter(timeZone) {
+  let formatter=dateFormatters.get(timeZone);
+  if(!formatter){
+    formatter=new Intl.DateTimeFormat("en-CA",{timeZone,year:"numeric",month:"2-digit",day:"2-digit"});
+    if(dateFormatters.size>=8)dateFormatters.delete(dateFormatters.keys().next().value);
+    dateFormatters.set(timeZone,formatter);
+  }
+  return formatter;
+}
+export function localDate(ts, timeZone = "Europe/Warsaw") {
+  const d = new Date(ts);
+  if (Number.isNaN(d.getTime())) throw new AccountingError("INVALID_TIMESTAMP", "Invalid timestamp");
+  return dateFormatter(timeZone).format(d);
+}
+// Métodos reales de la app (RPC de pedidos): Efectivo, Transferencia, Datafono, Pago en caja, Pago al recoger, Online.
+const OFFLINE = new Set(["cash", "efectivo", "gotowka", "terminal", "card_terminal", "datafono", "pago en caja", "pago al recoger", "transferencia"]);
+const norm = (m) => String(m ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
+const isOffline = (m) => OFFLINE.has(norm(m));
+const REFUND_DONE = new Set(["succeeded", "refunded", "completed", "processed"]);
+
+export function canonicalJson(v) {
+  if (Array.isArray(v)) return `[${v.map(canonicalJson).join(",")}]`;
+  if (v && typeof v === "object") return `{${Object.keys(v).sort().map((k) => `${JSON.stringify(k)}:${canonicalJson(v[k])}`).join(",")}}`;
+  return JSON.stringify(v);
+}
+
+export function buildDailyClose(input, { date, timeZone = "Europe/Warsaw", defaultVatRate = null, fiscalRequired = false } = {}) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(date ?? "")) throw new AccountingError("INVALID_DATE", "date must be YYYY-MM-DD");
+  if (Number.isNaN(Date.parse(date+"T00:00:00Z")) || new Date(date+"T00:00:00Z").toISOString().slice(0,10)!==date) throw new AccountingError("INVALID_DATE", "Invalid calendar date");
+  const issues = [];
+  const issue = (code, ref, detail = "") => issues.push({ code, ref, detail });
+  let { orders = [], payments = [], refunds = [], allocations = [], fiscalOps = [] } = input;
+
+  for(const rows of [orders,payments,refunds,allocations,fiscalOps])if(!Array.isArray(rows))throw new AccountingError("INVALID_INPUT","Expected arrays of audit records");
+
+  // Ambiguous duplicate records are excluded and explicitly invalidate the audit.
+  function unambiguous(rows, field, code) {
+    rows = rows.filter(row=>{if(!row || typeof row[field]!=="string" || !row[field].trim() || row[field]!==row[field].trim()){issue("INVALID_RECORD_ID",field);return false;}return true;});
+    const counts = new Map(); for (const row of rows) counts.set(row[field], (counts.get(row[field]) ?? 0) + 1);
+    for (const [id, n] of counts) if (n > 1) issue(code, id, `${n} records excluded`);
+    return rows.filter(row => counts.get(row[field]) === 1);
+  }
+  orders = unambiguous(orders, "id", "DUPLICATE_ORDER_ID");
+  payments = unambiguous(payments, "id", "DUPLICATE_PAYMENT_ID");
+  refunds = unambiguous(refunds, "id", "DUPLICATE_REFUND_ID");
+  allocations = unambiguous(allocations, "payment_transaction_id", "DUPLICATE_ALLOCATION");
+  const references = new Map();
+  for (const pay of payments) if (pay.provider_reference) references.set(pay.provider_reference, (references.get(pay.provider_reference) ?? 0) + 1);
+  for (const [ref, n] of references) if (n > 1) issue("DUPLICATE_PROVIDER_REFERENCE", ref);
+
+  const paymentsByOrder = new Map();
+  for (const p of payments) {
+    if (p.currency !== "PLN") issue("CURRENCY_NOT_PLN", p.id, p.currency);
+    if (!paymentsByOrder.has(p.customer_order_id)) paymentsByOrder.set(p.customer_order_id, []);
+    paymentsByOrder.get(p.customer_order_id).push(p);
+  }
+  const allocByPayment = new Map(allocations.map((a) => [a.payment_transaction_id, a]));
+  const fiscalOk = new Set(fiscalOps.filter((f) => f.state === "confirmed" && f.fiscal === true && f.simulated !== true).map((f) => f.order_id));
+
+  const totals = { orders: 0, grossGrosz: 0, byPaymentMethod: {}, byChannel: {} };
+  const vatDocuments = [];
+  const refundVatDocuments = [];
+  const quantitiesByProduct = {};
+  function increment(object, key, amount) {
+    const n = (Object.hasOwn(object, key) ? object[key] : 0) + amount;
+    if (!Number.isSafeInteger(n)) throw new AccountingError("MONEY_OVERFLOW", "Unsafe accumulated value");
+    Object.defineProperty(object, key, {value:n,enumerable:true,writable:true,configurable:true});
+  }
+  const soldOrderIds = new Set();
+  let vatAssumed = 0;
+
+  for (const o of orders) {
+    if (o.currency !== "PLN") { issue("CURRENCY_NOT_PLN", o.id, o.currency); continue; }
+    const paid = (paymentsByOrder.get(o.id) ?? []).filter((p) => p.status === "paid" || p.status === "partially_refunded" || p.status === "refunded");
+    const online = o.payment_status === "paid" || paid.length > 0;
+    const offlineSale = isOffline(o.payment_method) && o.status === "delivered";
+    if (!online && !offlineSale) continue;
+    if (localDate(o.created_at, timeZone) !== date) continue;
+
+    const total = toGrosz(o.total);
+    soldOrderIds.add(o.id);
+    const vatLines = [];
+    totals.orders += 1; increment(totals, "grossGrosz", total);
+    const method = norm(o.payment_method) || "unknown";
+    increment(totals.byPaymentMethod, method, total);
+    const channel = o.channel || "own_app";
+    increment(totals.byChannel, channel, total);
+
+    if (paid.length > 1) issue("DUPLICATE_PAYMENT_FOR_ORDER", o.id, `${paid.length} pagos`);
+    if (online && !isOffline(o.payment_method)) {
+      const p = paid[0];
+      if (!p) issue("PAID_ORDER_WITHOUT_PAYMENT", o.id);
+      else {
+        if (toGrosz(p.amount) !== total) issue("PAYMENT_AMOUNT_MISMATCH", o.id, `${p.amount} vs ${o.total}`);
+        const a = allocByPayment.get(p.id);
+        if (!a) issue("ALLOCATION_MISSING", o.id);
+        else if (sum([toGrosz(a.restaurant_net_amount), toGrosz(a.courier_net_amount), toGrosz(a.platform_amount)]) !== toGrosz(a.gross_amount)) issue("ALLOCATION_SUM_MISMATCH", o.id);
+        else if (toGrosz(a.gross_amount) !== total) issue("ALLOCATION_GROSS_MISMATCH", o.id);
+      }
+    }
+    if (fiscalRequired && !fiscalOk.has(o.id)) issue("FISCAL_RECEIPT_MISSING", o.id);
+
+    // Líneas para IVA: items + envío. Sin IVA por línea => defaultVatRate (marcado como asumido) o error.
+    const items = Array.isArray(o.items) ? o.items : null;
+    if (items) {
+      const itemsTotal = sum([sum(items, (i) => toGrosz(i.lineTotal)), o.delivery_fee != null ? toGrosz(o.delivery_fee) : 0]);
+      if (itemsTotal !== total) issue("ORDER_TOTAL_MISMATCH", o.id, `${fromGrosz(itemsTotal)} vs ${o.total}`);
+      for (const i of items) {
+        if (i.productId && Number.isSafeInteger(i.quantity) && i.quantity > 0) increment(quantitiesByProduct, i.productId, i.quantity);
+        let rate = i.vatRate;
+        if (rate == null && i.vatSnapshotPresent) { issue("VAT_SNAPSHOT_UNKNOWN", o.id); continue; }
+        if (rate == null) { rate = defaultVatRate; vatAssumed += 1; }
+        if (rate == null) { issue("VAT_RATE_MISSING", o.id); continue; }
+        vatLines.push({ grossGrosz: toGrosz(i.lineTotal), vatRate: normalizeRate(rate) });
+      }
+      if (o.delivery_fee != null && toGrosz(o.delivery_fee) > 0) {
+        const r = o.delivery_vat_rate ?? (o.deliveryVatSnapshotPresent ? null : defaultVatRate);
+        if (r == null) issue("VAT_RATE_MISSING", o.id, "delivery_fee");
+        else vatLines.push({ grossGrosz: toGrosz(o.delivery_fee), vatRate: normalizeRate(r) });
+      }
+    } else issue("ORDER_WITHOUT_ITEMS_FOR_VAT", o.id);
+    vatDocuments.push(vatSummary(vatLines));
+  }
+
+  // Reembolsos reconocidos en su propia fecha de proceso.
+  const paymentById = new Map(payments.map(p=>[p.id,p]));
+  const paymentAmount = new Map(payments.map((p) => [p.id, toGrosz(p.amount)]));
+  const refundedByPayment = new Map();
+  let refundsGrosz = 0, refundCount = 0;
+  for (const r of refunds) {
+    if (!REFUND_DONE.has(String(r.status))) { if (!["pending", "processing", "failed"].includes(String(r.status))) issue("UNKNOWN_REFUND_STATUS", r.id, r.status); continue; }
+    const amt = toGrosz(r.amount);
+    const payment = paymentById.get(r.payment_transaction_id);
+    if (!r.processed_at) issue("REFUND_TIMESTAMP_MISSING",r.id);
+    if (!payment) issue("REFUND_WITHOUT_PAYMENT",r.id);
+    if (payment && r.customer_order_id && r.customer_order_id!==payment.customer_order_id) issue("REFUND_ORDER_MISMATCH",r.id);
+    if (payment && (payment.currency!=="PLN" || (r.currency!=null && r.currency!==payment.currency))) issue("REFUND_CURRENCY_MISMATCH",r.id);
+    if (amt<0){issue("NEGATIVE_REFUND",r.id);continue;}
+    refundedByPayment.set(r.payment_transaction_id, sum([refundedByPayment.get(r.payment_transaction_id) ?? 0, amt]));
+    if (r.processed_at && localDate(r.processed_at, timeZone) === date) {
+      refundsGrosz = sum([refundsGrosz, amt]); refundCount += 1;
+      if (!Array.isArray(r.vatLines)) issue("REFUND_VAT_ALLOCATION_REQUIRED", r.id);
+      else {
+        const summary = vatSummary(r.vatLines);
+        if (summary.gross !== amt) issue("REFUND_VAT_AMOUNT_MISMATCH", r.id);
+        else refundVatDocuments.push(summary);
+      }
+    }
+  }
+  for (const [pid, amt] of refundedByPayment) {
+    if (paymentAmount.has(pid) && amt > paymentAmount.get(pid)) issue("REFUND_EXCEEDS_PAYMENT", pid, `${fromGrosz(amt)} > ${fromGrosz(paymentAmount.get(pid))}`);
+  }
+
+  // Comisiones y reparto del día (solo asignaciones de pedidos vendidos ese día).
+  const dayOrderIds = soldOrderIds;
+  const dayAllocs = allocations.filter((a) => dayOrderIds.has(a.customer_order_id));
+  const split = {
+    platformGrosz: sum(dayAllocs, (a) => toGrosz(a.platform_amount)),
+    restaurantNetGrosz: sum(dayAllocs, (a) => toGrosz(a.restaurant_net_amount)),
+    courierNetGrosz: sum(dayAllocs, (a) => toGrosz(a.courier_net_amount)),
+  };
+
+  function sumDocuments(documents) {
+    const total = { byRate: {}, gross: 0, net: 0, vat: 0 };
+    for (const document of documents) {
+      for (const field of ["gross", "net", "vat"]) increment(total, field, document[field]);
+      for (const [rate, part] of Object.entries(document.byRate)) {
+        total.byRate[rate] ??= { gross: 0, net: 0, vat: 0 };
+        for (const field of ["gross", "net", "vat"]) increment(total.byRate[rate], field, part[field]);
+      }
+    }
+    return total;
+  }
+  const vat = sumDocuments(vatDocuments);
+  const refundVat = sumDocuments(refundVatDocuments);
+  const vatAfterRefunds = { gross: sum([vat.gross,-refundVat.gross]), net: sum([vat.net,-refundVat.net]), vat: sum([vat.vat,-refundVat.vat]) };
+  const body = {
+    date, timeZone, currency: "PLN",
+    orders: totals.orders, grossGrosz: totals.grossGrosz,
+    refundsGrosz, refundCount, netAfterRefundsGrosz: sum([totals.grossGrosz, -refundsGrosz]),
+    valid: issues.length === 0, quantitiesByProduct,
+    byPaymentMethod: totals.byPaymentMethod, byChannel: totals.byChannel,
+    vat, refundVat, vatAfterRefunds, vatAssumedLines: vatAssumed, split, issues,
+  };
+  return { ...body, checksum: createHash("sha256").update(canonicalJson(body)).digest("hex") };
+}
diff --git a/accounting/src/money.mjs b/accounting/src/money.mjs
new file mode 100644
index 0000000..83d8ac2
--- /dev/null
+++ b/accounting/src/money.mjs
@@ -0,0 +1,15 @@
+/** Dinero exacto en grosze (enteros). numeric(12,2) de Postgres -> entero sin pasar por floats. */
+export class AccountingError extends Error {
+  constructor(code, message) { super(message); this.name = "AccountingError"; this.code = code; }
+}
+export function toGrosz(value) {
+  if (typeof value === "number" && Number.isFinite(value) && Math.abs(value * 100 - Math.round(value * 100)) > 0.000001) throw new AccountingError("INVALID_MONEY", "More than two decimal places");
+  const s = typeof value === "number" ? (Number.isFinite(value) ? value.toFixed(2) : "") : String(value ?? "").trim();
+  const m = /^(-?)(\d{1,12})(?:\.(\d{1,2}))?$/.exec(s);
+  if (!m) throw new AccountingError("INVALID_MONEY", `Invalid amount: ${String(value).slice(0, 30)}`);
+  const n = Number(m[2]) * 100 + Number((m[3] ?? "").padEnd(2, "0") || 0);
+  if (!Number.isSafeInteger(n)) throw new AccountingError("MONEY_OVERFLOW", "Amount exceeds safe range");
+  return m[1] ? -n : n;
+}
+export const fromGrosz = (g) => `${g < 0 ? "-" : ""}${Math.floor(Math.abs(g) / 100)}.${String(Math.abs(g) % 100).padStart(2, "0")}`;
+export const sum = (arr, f = (x) => x) => arr.reduce((a, x) => { const n = a + f(x); if (!Number.isSafeInteger(n)) throw new AccountingError("MONEY_OVERFLOW", "Unsafe total"); return n; }, 0);
diff --git a/accounting/src/monthly-close.mjs b/accounting/src/monthly-close.mjs
new file mode 100644
index 0000000..48b0f7e
--- /dev/null
+++ b/accounting/src/monthly-close.mjs
@@ -0,0 +1,30 @@
+import { createHash } from "node:crypto";
+import { AccountingError, sum } from "./money.mjs";
+import { canonicalJson } from "./daily-close.mjs";
+import { RATES } from "./vat.mjs";
+
+export function buildMonthlyClose(days, month) {
+  if (!/^\d{4}-(?:0[1-9]|1[0-2])$/.test(month ?? "")) throw new AccountingError("INVALID_MONTH", "month must be YYYY-MM");
+  const inMonth = days.filter((d) => d.date.startsWith(month)).sort((a, b) => a.date.localeCompare(b.date));
+  const [y, m] = month.split("-").map(Number);
+  const dim = new Date(Date.UTC(y, m, 0)).getUTCDate();
+  const have = new Set(inMonth.map((d) => d.date));
+  const missingDays = [];
+  for (let d = 1; d <= dim; d++) { const k = `${month}-${String(d).padStart(2, "0")}`; if (!have.has(k)) missingDays.push(k); }
+  if (have.size !== inMonth.length) throw new AccountingError("DUPLICATE_DAY", "Duplicate daily close");
+
+  const t = { orders: 0, grossGrosz: 0, refundsGrosz: 0, platformGrosz: 0, restaurantNetGrosz: 0, courierNetGrosz: 0 };
+  const vat = Object.fromEntries(RATES.map((r) => [r, { gross: 0, net: 0, vat: 0 }]));
+  const issues = [];
+  const refundVat = {gross:0,net:0,vat:0};
+  for (const d of inMonth) {
+    for (const key of ["gross","net","vat"]) refundVat[key] = sum([refundVat[key], d.refundVat?.[key] ?? 0]);
+    t.orders = sum([t.orders,d.orders]); t.grossGrosz = sum([t.grossGrosz,d.grossGrosz]); t.refundsGrosz = sum([t.refundsGrosz,d.refundsGrosz]);
+    t.platformGrosz = sum([t.platformGrosz,d.split.platformGrosz]); t.restaurantNetGrosz = sum([t.restaurantNetGrosz,d.split.restaurantNetGrosz]); t.courierNetGrosz = sum([t.courierNetGrosz,d.split.courierNetGrosz]);
+    for (const [r, v] of Object.entries(d.vat.byRate)) { if(!Object.hasOwn(vat,r))throw new AccountingError("UNKNOWN_VAT_RATE","Unknown daily VAT category");
+      for(const k of ["gross","net","vat"])vat[r][k]=sum([vat[r][k],v[k]]); }
+    for (const i of d.issues) issues.push({ date: d.date, ...i });
+  }
+  const body = { month, days: inMonth.length, missingDays, ...t, netAfterRefundsGrosz: sum([t.grossGrosz, -t.refundsGrosz]), vatByRate: vat, refundVat, vatAfterRefunds: {gross: sum([sum(Object.values(vat),v=>v.gross),-refundVat.gross]), net: sum([sum(Object.values(vat),v=>v.net),-refundVat.net]), vat: sum([sum(Object.values(vat),v=>v.vat),-refundVat.vat])}, issuesCount: issues.length, issues };
+  return { ...body, sealed: createHash("sha256").update(canonicalJson(body)).digest("hex"), complete: missingDays.length === 0 && issues.length === 0 && inMonth.every(d=>d.valid!==false) };
+}
diff --git a/accounting/src/reconcile.mjs b/accounting/src/reconcile.mjs
new file mode 100644
index 0000000..d521942
--- /dev/null
+++ b/accounting/src/reconcile.mjs
@@ -0,0 +1,61 @@
+import { toGrosz, sum } from "./money.mjs";
+
+/** Never collapse duplicate references into a Map: ambiguous groups cannot match. */
+/**
+ * aggregateProviderRows (opt-in): el proveedor puede tener VARIAS filas por referencia (cargo, reembolso, ajuste).
+ * Cada movimiento exige event_id único (identidad oficial del movimiento, no la venta).
+ * Se suman con signo y se comparan con amount - refunded_amount del pago local. Los duplicados LOCALES nunca se agregan.
+ */
+export function reconcileProvider(localPayments, providerRows, { aggregateProviderRows = false } = {}) {
+  const out = { matched: [], missingInProvider: [], missingLocal: [], amountMismatch: [], currencyMismatch: [], duplicateLocal: [], duplicateProvider: [], invalidReferences: [], invalidProviderEvents: [], aggregatedProvider: [] };
+  function group(rows, field, side) {
+    const groups = new Map();
+    for (const [index, row] of rows.entries()) {
+      const raw = row[field];
+      if (typeof raw !== 'string' || !raw.trim() || raw !== raw.trim()) {
+        out.invalidReferences.push({ side, index }); continue;
+      }
+      const entries = groups.get(raw) ?? []; entries.push(row); groups.set(raw, entries);
+    }
+    return groups;
+  }
+  const local = group(localPayments, 'provider_reference', 'local');
+  const prov = group(providerRows, 'reference', 'provider');
+  for (const [ref, rows] of local) if (rows.length > 1) out.duplicateLocal.push({ ref, count: rows.length });
+  const unsafe = new Set();
+  if (aggregateProviderRows) {
+    const events = new Map();
+    for (const [ref, rows] of prov) for (const row of rows) {
+      const id = row.event_id;
+      if (typeof id !== 'string' || !id.trim() || id !== id.trim()) {
+        unsafe.add(ref); out.invalidProviderEvents.push({ ref, reason: 'event_id_required' }); continue;
+      }
+      if (events.has(id)) {
+        unsafe.add(ref); unsafe.add(events.get(id));
+        out.invalidProviderEvents.push({ ref, eventId: id, reason: 'duplicate_event_id' });
+      } else events.set(id, ref);
+    }
+  }
+  for (const [ref, rows] of prov) if (rows.length > 1 && (!aggregateProviderRows || unsafe.has(ref))) out.duplicateProvider.push({ ref, count: rows.length });
+  for (const [ref, payments] of local) {
+    const rows = prov.get(ref);
+    if (!rows) { if (payments.some(p => p.status === 'paid')) out.missingInProvider.push(ref); continue; }
+    if (unsafe.has(ref) || payments.length !== 1 || (rows.length !== 1 && !aggregateProviderRows)) continue;
+    const p = payments[0], r = rows[0];
+    if (aggregateProviderRows && new Set(rows.map((x) => String(x.currency ?? '').toUpperCase())).size > 1) { out.currencyMismatch.push(ref); continue; }
+    if (!/^[A-Z]{3}$/.test(String(r.currency ?? '').toUpperCase()) || !/^[A-Z]{3}$/.test(String(p.currency ?? '').toUpperCase()) || String(r.currency).toUpperCase() !== String(p.currency).toUpperCase()) { out.currencyMismatch.push(ref); continue; }
+    const gross = toGrosz(p.amount), refund = aggregateProviderRows && p.refunded_amount != null ? toGrosz(p.refunded_amount) : 0;
+    if (gross < 0 || refund < 0 || refund > gross || (aggregateProviderRows && ((p.status === 'paid' && refund !== 0) || (p.status === 'refunded' && refund !== gross) || (p.status === 'partially_refunded' && (refund <= 0 || refund >= gross))))) {
+      out.amountMismatch.push({ ref, reason: 'invalid_local_refund' }); continue;
+    }
+    const a = sum([gross, -refund]);
+    const b = aggregateProviderRows ? sum(rows, x => toGrosz(x.amount)) : toGrosz(r.amount);
+    if (aggregateProviderRows && rows.length > 1) out.aggregatedProvider.push({ ref, eventIds: rows.map(x => x.event_id), totalGrosz: b });
+    if (a !== b) out.amountMismatch.push({ ref, local: a, provider: b });
+    else if (!['paid', 'partially_refunded', 'refunded'].includes(p.status)) out.amountMismatch.push({ ref, reason: 'local_not_settled' });
+    else out.matched.push(ref);
+  }
+  for (const ref of prov.keys()) if (!local.has(ref)) out.missingLocal.push(ref);
+  out.ok = Object.entries(out).every(([key, value]) => ['matched', 'aggregatedProvider'].includes(key) || value.length === 0);
+  return out;
+}
diff --git a/accounting/src/vat.mjs b/accounting/src/vat.mjs
new file mode 100644
index 0000000..1b583ec
--- /dev/null
+++ b/accounting/src/vat.mjs
@@ -0,0 +1,46 @@
+/**
+ * Configured gross/net split by rate within a document. Confirm rounding with the accountant and device.
+ * Arithmetic groups by rate within a document
+ * (no línea a línea), con redondeo half-up a grosz. Tasas: 23, 8, 5, 0 y ZW (exento).
+ */
+import { AccountingError, sum } from "./money.mjs";
+
+export const RATES = Object.freeze(["23", "8", "5", "0", "ZW", "NP", "NP I", "NP II"]);
+
+export function normalizeRate(rate, verifiedLetterMap = null) {
+  const raw = String(rate ?? "").trim().toUpperCase();
+  if (verifiedLetterMap && Object.hasOwn(verifiedLetterMap, raw)) return normalizeRate(verifiedLetterMap[raw]);
+  if (raw === "ZW" || raw === "EXEMPT") return "ZW";
+  if (["NP", "NP I", "NP II"].includes(raw)) return raw;
+  const digits = raw.replace(/[^0-9]/g, "");
+  if (/^(?:VAT_)?(?:23|8|5|0)$/.test(raw) && RATES.includes(digits)) return digits;
+  throw new AccountingError("UNKNOWN_VAT_RATE", `Unknown VAT rate: ${raw.slice(0, 20)}`);
+}
+
+export function splitGross(grossGrosz, rate) {
+  if (!Number.isSafeInteger(grossGrosz)) throw new AccountingError("INVALID_MONEY", "Gross must be safe integer minor units");
+  const r = normalizeRate(rate);
+  if (r === "0" || r === "ZW" || r.startsWith("NP")) return { gross: grossGrosz, net: grossGrosz, vat: 0 };
+  const sign = grossGrosz < 0 ? -1 : 1;
+  const g = Math.abs(grossGrosz), d = 100 + Number(r);
+  const net = Number((BigInt(g) * 200n + BigInt(d)) / (2n * BigInt(d))); // round half up de g*100/d
+  return { gross: sign * g, net: sign * net, vat: sign * (g - net) };
+}
+
+/** lines: [{ grossGrosz, vatRate }] -> { byRate: {rate:{gross,net,vat}}, gross, net, vat } */
+export function vatSummary(lines) {
+  const acc = {};
+  for (const l of lines) {
+    const r = normalizeRate(l.vatRate);
+    if (!Number.isSafeInteger(l.grossGrosz)) throw new AccountingError("INVALID_MONEY", "Invalid VAT line minor units");
+    acc[r] = sum([acc[r] ?? 0, l.grossGrosz]);
+  }
+  const byRate = {};
+  let gross = 0, net = 0, vat = 0;
+  for (const r of RATES) {
+    if (acc[r] === undefined) continue;
+    const s = splitGross(acc[r], r);
+    byRate[r] = s; gross = sum([gross, s.gross]); net = sum([net, s.net]); vat = sum([vat, s.vat]);
+  }
+  return { byRate, gross, net, vat };
+}
diff --git a/accounting/tests/accounting.test.mjs b/accounting/tests/accounting.test.mjs
