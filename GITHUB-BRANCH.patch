+-- V5-20261010-02: tasa de IVA normalizada (23, 8, 5, 0, ZW) o NULL si es desconocida. No bloquea ventas.
+create or replace function public.rc_ordera_normalize_vat_rate(p jsonb)
+returns text
+language sql
+immutable
+set search_path = pg_catalog, public
+as $$
+  select case upper(btrim(coalesce(p #>> '{}', '')))
+    when '23' then '23' when 'A' then '23' when 'VAT_23' then '23'
+    when '8'  then '8'  when 'B' then '8'  when 'VAT_8'  then '8'
+    when '5'  then '5'  when 'C' then '5'  when 'VAT_5'  then '5'
+    when '0'  then '0'  when 'D' then '0'  when 'VAT_0'  then '0'
+    when 'ZW' then 'ZW' when 'E' then 'ZW' when 'EXEMPT' then 'ZW' when 'NP' then 'ZW'
+    else null
+  end
+$$;
